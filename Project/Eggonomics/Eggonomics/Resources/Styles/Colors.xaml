<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Primary palette — warm amber / egg yolk -->
    <Color x:Key="Primary">#D97706</Color>
    <Color x:Key="PrimaryLight">#FCD34D</Color>
    <Color x:Key="PrimaryDark">#FCD34D</Color>
    <Color x:Key="PrimaryDarkText">#1C1208</Color>
    <Color x:Key="Secondary">#FEF3C7</Color>
    <Color x:Key="SecondaryDarkText">#D97706</Color>
    <Color x:Key="Tertiary">#B45309</Color>

    <!-- Backgrounds -->
    <Color x:Key="PageBgLight">#FFFBF0</Color>
    <Color x:Key="PageBgDark">#1C1208</Color>
    <Color x:Key="SurfaceLight">#FFFFFF</Color>
    <Color x:Key="SurfaceDark">#2A1A08</Color>

    <!-- Borders -->
    <Color x:Key="BorderLight">#FDE68A</Color>
    <Color x:Key="BorderDark">#78350F</Color>

    <!-- Input fields -->
    <Color x:Key="InputBgLight">#FFFBEB</Color>
    <Color x:Key="InputBgDark">#3D2A10</Color>

    <!-- Semantic -->
    <Color x:Key="Success">#16A34A</Color>
    <Color x:Key="Danger">#DC2626</Color>
    <Color x:Key="Warning">#EA580C</Color>

    <!-- General -->
    <Color x:Key="White">White</Color>
    <Color x:Key="Black">Black</Color>
    <Color x:Key="Magenta">#D97706</Color>
    <Color x:Key="MidnightBlue">#1C1208</Color>
    <Color x:Key="OffBlack">#1C1208</Color>

    <!-- Warm grays -->
    <Color x:Key="Gray100">#F5F0E8</Color>
    <Color x:Key="Gray200">#E8DECE</Color>
    <Color x:Key="Gray300">#D5C5AB</Color>
    <Color x:Key="Gray400">#B8A48A</Color>
    <Color x:Key="Gray500">#92806A</Color>
    <Color x:Key="Gray600">#6B5C46</Color>
    <Color x:Key="Gray900">#2D1F0A</Color>
    <Color x:Key="Gray950">#1C1208</Color>

    <SolidColorBrush x:Key="PrimaryBrush"    Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="SecondaryBrush"  Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="TertiaryBrush"   Color="{StaticResource Tertiary}"/>
    <SolidColorBrush x:Key="WhiteBrush"      Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush"      Color="{StaticResource Black}"/>
    <SolidColorBrush x:Key="Gray100Brush"    Color="{StaticResource Gray100}"/>
    <SolidColorBrush x:Key="Gray200Brush"    Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="Gray300Brush"    Color="{StaticResource Gray300}"/>
    <SolidColorBrush x:Key="Gray400Brush"    Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="Gray500Brush"    Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="Gray600Brush"    Color="{StaticResource Gray600}"/>
    <SolidColorBrush x:Key="Gray900Brush"    Color="{StaticResource Gray900}"/>
    <SolidColorBrush x:Key="Gray950Brush"    Color="{StaticResource Gray950}"/>

</ResourceDictionary>
