<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Eggonomics.Views.FridgePage">

    <Grid>

        <Grid RowDefinitions="Auto,Auto,*" Padding="16,12" RowSpacing="12">

            <Grid Grid.Row="0" ColumnDefinitions="Auto,*">
                <Button Text="← Back"
                        Command="{Binding GoBackCommand}"
                        HorizontalOptions="Start" />
                <Label Grid.Column="1"
                       Text="{Binding FridgeName}"
                       FontSize="24"
                       FontAttributes="Bold"
                       VerticalOptions="Center"
                       Margin="12,0,0,0" />
            </Grid>

            <HorizontalStackLayout Grid.Row="1" Spacing="8">
                <Button Text="Insert"
                        Command="{Binding InsertCommand}" />
                <Button Text="+ Add Tray"
                        Command="{Binding OpenTraySelectCommand}" />
            </HorizontalStackLayout>

            <CollectionView Grid.Row="2" ItemsSource="{Binding EggTrays}">
                <CollectionView.EmptyView>
                    <Label Text="No egg trays yet."
                           TextColor="Gray"
                           HorizontalOptions="Center"
                           Margin="0,24" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="16,12"
                                Margin="0,4"
                                StrokeShape="RoundRectangle 8">
                            <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="4">
                                <Label Grid.Row="0" Grid.Column="0"
                                       Text="{Binding Name}"
                                       FontSize="16"
                                       FontAttributes="Bold" />
                                <Label Grid.Row="0" Grid.Column="1"
                                       Text="{Binding Origin}"
                                       FontSize="14"
                                       HorizontalOptions="End" />
                                <Label Grid.Row="1" Grid.Column="0"
                                       Text="{Binding QuantityRemaining, StringFormat='{0} eggs remaining'}"
                                       FontSize="13"
                                       TextColor="Gray" />
                                <Label Grid.Row="1" Grid.Column="1"
                                       Text="{Binding Price, StringFormat='{0:F2} CZK'}"
                                       FontSize="13"
                                       TextColor="Gray"
                                       HorizontalOptions="End" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </Grid>

        <Grid IsVisible="{Binding IsTraySelectVisible}">

            <BoxView Color="Black" Opacity="0.9" />

            <Border HorizontalOptions="Center"
                    VerticalOptions="Center"
                    WidthRequest="320"
                    Padding="24"
                    StrokeShape="RoundRectangle 12">
                <VerticalStackLayout Spacing="16">

                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Add Egg Tray"
                               FontSize="18"
                               FontAttributes="Bold"
                               VerticalOptions="Center" />
                        <Button Grid.Column="1"
                                Text="✕"
                                Command="{Binding CloseTraySelectCommand}"
                                WidthRequest="36"
                                HeightRequest="36"
                                Padding="0"
                                FontSize="14" />
                    </Grid>

                    <Label Text="Name" FontSize="13" />
                    <Entry Placeholder="Name" Text="{Binding Name}" />

                    <Label Text="Price" FontSize="13" />
                    <Entry Placeholder="0" Text="{Binding Price}" Keyboard="Numeric" />

                    <Label Text="Origin" FontSize="13" />
                    <Picker ItemsSource="{Binding Origins}" SelectedItem="{Binding Origin}" />

                    <Label Text="Quantity" FontSize="13" />
                    <Entry Placeholder="0" Text="{Binding QuantityAdded}" Keyboard="Numeric" />

                    <Label Text="Expiration Date" FontSize="13" />
                    <DatePicker Date="{Binding ExpirationDate}" />

                    <Label Text="Notes" FontSize="13" />
                    <Entry Placeholder="Notes" Text="{Binding Notes}" />

                    <Label Text="{Binding ErrorMessage}"
                           TextColor="Red"
                           IsVisible="{Binding HasError}"
                           FontSize="13" />

                    <Button Text="Add tray"
                            Command="{Binding AddTrayCommand}" />

                </VerticalStackLayout>
            </Border>

        </Grid>

    </Grid>

</ContentPage>
