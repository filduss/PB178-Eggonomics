<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Eggonomics.Views.FridgePage">

    <Grid>

        <Grid RowDefinitions="Auto,Auto,*" Padding="20,16" RowSpacing="14">

            <Grid Grid.Row="0" ColumnDefinitions="Auto,*">
                <Button Text="← Back"
                        Style="{StaticResource OutlineButtonStyle}"
                        Command="{Binding GoBackCommand}"
                        HorizontalOptions="Start" />
                <Label Grid.Column="1"
                       Text="{Binding FridgeName}"
                       Style="{StaticResource PageTitleStyle}"
                       Margin="12,0,0,0" />
            </Grid>

            <HorizontalStackLayout Grid.Row="1" Spacing="8">
                <Button Text="+ Add Tray"
                        Command="{Binding OpenTraySelectCommand}" />
                <Button Text="Take Eggs"
                        Style="{StaticResource OutlineButtonStyle}"
                        Command="{Binding OpenTakeEggsCommand}" />
                <Button Text="Overview"
                        Style="{StaticResource OutlineButtonStyle}"
                        Command="{Binding GoToOverviewCommand}" />
            </HorizontalStackLayout>

            <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="16">

                <Grid RowDefinitions="Auto,*" RowSpacing="10">
                    <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                        <Label Text="Egg Trays"
                               Style="{StaticResource SectionTitleStyle}" />
                        <Label Text="{Binding TotalEggs, StringFormat='({0} total)'}"
                               Style="{StaticResource MutedLabelStyle}"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>

                    <CollectionView Grid.Row="1" ItemsSource="{Binding EggTrays}">
                        <CollectionView.EmptyView>
                            <VerticalStackLayout Spacing="6" HorizontalOptions="Center" Margin="0,24">
                                <Label Text="🥚" FontSize="32" HorizontalOptions="Center" />
                                <Label Text="No egg trays yet."
                                       Style="{StaticResource MutedLabelStyle}"
                                       HorizontalOptions="Center" />
                            </VerticalStackLayout>
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,4"
                                        Style="{StaticResource CardStyle}">
                                    <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="4">

                                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                                            <Label Grid.Column="0"
                                                   Text="{Binding Name}"
                                                   FontSize="15"
                                                   FontAttributes="Bold" />
                                            <Border Grid.Column="1"
                                                    Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}"
                                                    StrokeShape="RoundRectangle 4"
                                                    StrokeThickness="1"
                                                    BackgroundColor="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource SurfaceDark}}"
                                                    Padding="6,2">
                                                <Label Text="{Binding Origin}"
                                                       FontSize="11"
                                                       TextColor="{AppThemeBinding Light={StaticResource Tertiary}, Dark={StaticResource PrimaryLight}}" />
                                            </Border>
                                        </Grid>

                                        <Label Grid.Row="1"
                                               Text="{Binding QuantityRemaining, StringFormat='{0} eggs remaining'}"
                                               Style="{StaticResource MutedLabelStyle}" />

                                        <Grid Grid.Row="2" ColumnDefinitions="*,Auto">
                                            <Label Grid.Column="0"
                                                   Text="{Binding Price, StringFormat='{0:F2} CZK'}"
                                                   Style="{StaticResource MutedLabelStyle}" />
                                            <Label Grid.Column="1"
                                                   Text="{Binding ExpirationDate, StringFormat='Exp: {0:MMM d}'}"
                                                   Style="{StaticResource MutedLabelStyle}"
                                                   HorizontalOptions="End" />
                                        </Grid>

                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Grid>

                <Grid Grid.Column="1" RowDefinitions="Auto,*" RowSpacing="10">
                    <Label Text="History"
                           Style="{StaticResource SectionTitleStyle}" />

                    <CollectionView Grid.Row="1" ItemsSource="{Binding Operations}">
                        <CollectionView.EmptyView>
                            <VerticalStackLayout Spacing="6" HorizontalOptions="Center" Margin="0,24">
                                <Label Text="📋" FontSize="32" HorizontalOptions="Center" />
                                <Label Text="No operations yet."
                                       Style="{StaticResource MutedLabelStyle}"
                                       HorizontalOptions="Center" />
                            </VerticalStackLayout>
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,4"
                                        Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}"
                                        StrokeShape="RoundRectangle 8"
                                        StrokeThickness="1.5"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                                        Padding="12,10">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding TypeLabel}" Value="gave">
                                            <Setter Property="Stroke" Value="{StaticResource Success}" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Border" Binding="{Binding TypeLabel}" Value="took">
                                            <Setter Property="Stroke" Value="{StaticResource Danger}" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Border" Binding="{Binding TypeLabel}" Value="expired">
                                            <Setter Property="Stroke" Value="{StaticResource Warning}" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="3">
                                        <Label Grid.Row="0" Grid.Column="0"
                                               FontSize="13">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="{Binding FridgeUser.User.DisplayName}"
                                                          FontAttributes="Bold" />
                                                    <Span Text=" " />
                                                    <Span Text="{Binding TypeLabel}" />
                                                    <Span Text=" " />
                                                    <Span Text="{Binding TotalQuantity}" />
                                                    <Span Text=" eggs" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>
                                        <Label Grid.Row="0" Grid.Column="1"
                                               Text="{Binding MonetaryValue, StringFormat='{0:F2} CZK'}"
                                               FontSize="13"
                                               FontAttributes="Bold"
                                               HorizontalOptions="End"
                                               VerticalOptions="Center" />
                                        <Label Grid.Row="1" Grid.Column="0"
                                               Grid.ColumnSpan="2"
                                               Text="{Binding PerformedAt, StringFormat='{0:MMM d, HH:mm}'}"
                                               Style="{StaticResource MutedLabelStyle}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Grid>

            </Grid>

        </Grid>

        <Grid IsVisible="{Binding IsTraySelectVisible}">

            <BoxView Color="Black" Opacity="0.7" />

            <Border HorizontalOptions="Center"
                    VerticalOptions="Center"
                    WidthRequest="340"
                    Padding="24"
                    Style="{StaticResource CardStyle}">
                <ScrollView>
                    <VerticalStackLayout Spacing="12">

                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Add Egg Tray"
                                   Style="{StaticResource ModalTitleStyle}" />
                            <Button Grid.Column="1"
                                    Text="✕"
                                    Style="{StaticResource OutlineButtonStyle}"
                                    Command="{Binding CloseTraySelectCommand}"
                                    WidthRequest="40"
                                    HeightRequest="40"
                                    Padding="0"
                                    FontSize="14" />
                        </Grid>

                        <BoxView HeightRequest="1"
                                 BackgroundColor="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" />

                        <Label Text="Name" Style="{StaticResource MutedLabelStyle}" />
                        <Border Style="{StaticResource InputBorderStyle}">
                            <Entry Placeholder="e.g. Bio eggs" Text="{Binding Name}" />
                        </Border>

                        <Label Text="Price (CZK)" Style="{StaticResource MutedLabelStyle}" />
                        <Border Style="{StaticResource InputBorderStyle}">
                            <Entry Placeholder="0.00" Text="{Binding Price}" Keyboard="Numeric" />
                        </Border>

                        <Label Text="Origin" Style="{StaticResource MutedLabelStyle}" />
                        <Border Style="{StaticResource InputBorderStyle}">
                            <Picker ItemsSource="{Binding Origins}" SelectedItem="{Binding Origin}" />
                        </Border>

                        <Label Text="Quantity" Style="{StaticResource MutedLabelStyle}" />
                        <Border Style="{StaticResource InputBorderStyle}">
                            <Entry Placeholder="0" Text="{Binding QuantityAdded}" Keyboard="Numeric" />
                        </Border>

                        <Label Text="Expiration Date" Style="{StaticResource MutedLabelStyle}" />
                        <Border Style="{StaticResource InputBorderStyle}">
                            <DatePicker Date="{Binding ExpirationDate}" />
                        </Border>

                        <Label Text="Notes (optional)" Style="{StaticResource MutedLabelStyle}" />
                        <Border Style="{StaticResource InputBorderStyle}">
                            <Entry Placeholder="Notes" Text="{Binding Notes}" />
                        </Border>

                        <Label Text="{Binding ErrorMessage}"
                               Style="{StaticResource ErrorLabelStyle}"
                               IsVisible="{Binding HasError}" />

                        <Button Text="Add Tray"
                                Command="{Binding AddTrayCommand}" />

                    </VerticalStackLayout>
                </ScrollView>
            </Border>

        </Grid>

        <Grid IsVisible="{Binding IsTakeEggsVisible}">

            <BoxView Color="Black" Opacity="0.7" />

            <Border HorizontalOptions="Center"
                    VerticalOptions="Center"
                    WidthRequest="320"
                    Padding="24"
                    Style="{StaticResource CardStyle}">
                <VerticalStackLayout Spacing="14">

                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Take Eggs"
                               Style="{StaticResource ModalTitleStyle}" />
                        <Button Grid.Column="1"
                                Text="✕"
                                Style="{StaticResource OutlineButtonStyle}"
                                Command="{Binding CloseTakeEggsCommand}"
                                WidthRequest="40"
                                HeightRequest="40"
                                Padding="0"
                                FontSize="14" />
                    </Grid>

                    <BoxView HeightRequest="1"
                             BackgroundColor="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" />

                    <Label Text="How many eggs would you like to take?"
                           Style="{StaticResource MutedLabelStyle}" />

                    <Border Style="{StaticResource InputBorderStyle}">
                        <Entry Placeholder="0"
                               Text="{Binding TakeQuantity}"
                               Keyboard="Numeric" />
                    </Border>

                    <Label Text="{Binding TakeErrorMessage}"
                           Style="{StaticResource ErrorLabelStyle}"
                           IsVisible="{Binding HasTakeError}" />

                    <Button Text="Take Eggs"
                            Command="{Binding TakeEggsCommand}" />

                </VerticalStackLayout>
            </Border>

        </Grid>

    </Grid>

</ContentPage>
