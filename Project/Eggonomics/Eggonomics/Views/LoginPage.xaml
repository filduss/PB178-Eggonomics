<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Eggonomics.ViewModels"
             x:Class="Eggonomics.Views.LoginPage"
             Title="Login">

    <Grid>

        <ScrollView>
            <VerticalStackLayout Spacing="0" Padding="32" VerticalOptions="Center"
                                 MaximumWidthRequest="420" HorizontalOptions="Center">

                <!-- Branding -->
                <Label Text="🥚"
                       FontSize="72"
                       HorizontalOptions="Center"
                       Margin="0,48,0,8" />

                <Label Text="Eggonomics"
                       FontSize="34"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"
                       TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryLight}}" />

                <Label Text="Track your fridge, share your eggs"
                       FontSize="14"
                       HorizontalOptions="Center"
                       Margin="0,6,0,40"
                       TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" />

                <!-- Email -->
                <Border Style="{StaticResource InputBorderStyle}"
                        Margin="0,0,0,12">
                    <Entry Placeholder="Email address"
                           Text="{Binding Email}"
                           Keyboard="Email" />
                </Border>

                <!-- Password -->
                <Border Style="{StaticResource InputBorderStyle}"
                        Margin="0,0,0,24">
                    <Entry Placeholder="Password"
                           Text="{Binding Password}"
                           IsPassword="True" />
                </Border>

                <Button Text="Log In"
                        Command="{Binding PerformLoginCommand}" />

                <Label Text="Don't have an account? Create one"
                       HorizontalOptions="Center"
                       Margin="0,20,0,48"
                       TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryLight}}"
                       TextDecorations="Underline">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenSignUpCommand}" />
                    </Label.GestureRecognizers>
                </Label>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Sign-up overlay -->
        <Grid IsVisible="{Binding IsSignUpVisible}">

            <BoxView Color="Black" Opacity="0.7" />

            <Border HorizontalOptions="Center"
                    VerticalOptions="Center"
                    WidthRequest="340"
                    Padding="24"
                    Style="{StaticResource CardStyle}">
                <VerticalStackLayout Spacing="14">

                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Create Account"
                               Style="{StaticResource ModalTitleStyle}" />
                        <Button Grid.Column="1"
                                Text="✕"
                                Style="{StaticResource OutlineButtonStyle}"
                                Command="{Binding CloseSignUpCommand}"
                                WidthRequest="40"
                                HeightRequest="40"
                                Padding="0"
                                FontSize="14" />
                    </Grid>

                    <Border Style="{StaticResource InputBorderStyle}">
                        <Entry Placeholder="Display name"
                               Text="{Binding SignUpDisplayName}" />
                    </Border>

                    <Border Style="{StaticResource InputBorderStyle}">
                        <Entry Placeholder="Email"
                               Text="{Binding SignUpEmail}"
                               Keyboard="Email" />
                    </Border>

                    <Border Style="{StaticResource InputBorderStyle}">
                        <Entry Placeholder="Password (min. 8 characters)"
                               Text="{Binding SignUpPassword}"
                               IsPassword="True" />
                    </Border>

                    <Border Style="{StaticResource InputBorderStyle}">
                        <Entry Placeholder="Confirm password"
                               Text="{Binding ConfirmPassword}"
                               IsPassword="True" />
                    </Border>

                    <Label Text="{Binding SignUpError}"
                           Style="{StaticResource ErrorLabelStyle}"
                           IsVisible="{Binding HasSignUpError}" />

                    <Button Text="Create Account"
                            Command="{Binding PerformRegisterCommand}" />

                </VerticalStackLayout>
            </Border>

        </Grid>

    </Grid>

</ContentPage>
