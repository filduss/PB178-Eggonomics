<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Eggonomics.Views.FridgesPage"
             xmlns:vm="clr-namespace:Eggonomics.ViewModels"
             x:Name="ThisPage">

    <Grid>

        <VerticalStackLayout Padding="20,16" Spacing="16">

            <Grid ColumnDefinitions="*,Auto">
                <VerticalStackLayout Spacing="2">
                    <Label Text="My Fridges"
                           Style="{StaticResource PageTitleStyle}" />
                    <Label Text="Tap a fridge to manage it"
                           Style="{StaticResource MutedLabelStyle}" />
                </VerticalStackLayout>
                <Button Grid.Column="1"
                        Text="Sign Out"
                        Style="{StaticResource OutlineButtonStyle}"
                        Command="{Binding SignOutCommand}"
                        VerticalOptions="Center" />
            </Grid>

            <Button Text="+ New Fridge"
                    HorizontalOptions="Start"
                    Command="{Binding OpenCreateFridgeCommand}" />

            <CollectionView ItemsSource="{Binding Fridges}">
                <CollectionView.EmptyView>
                    <VerticalStackLayout Spacing="8" HorizontalOptions="Center" Margin="0,32">
                        <Label Text="🗄️"
                               FontSize="48"
                               HorizontalOptions="Center" />
                        <Label Text="No fridges yet."
                               TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"
                               HorizontalOptions="Center" />
                        <Label Text="Create one to get started."
                               Style="{StaticResource MutedLabelStyle}"
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,5"
                                Style="{StaticResource CardStyle}">
                            <Grid RowDefinitions="Auto,Auto" RowSpacing="12">

                                <Label Grid.Row="0"
                                       Text="{Binding Fridge.Name}"
                                       FontSize="17"
                                       FontAttributes="Bold" />

                                <HorizontalStackLayout Grid.Row="1" Spacing="8" HorizontalOptions="End">
                                    <Button Text="Enter"
                                            Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.EnterFridgeCommand}"
                                            CommandParameter="{Binding Fridge}" />
                                    <Button Text="Members"
                                            Style="{StaticResource OutlineButtonStyle}"
                                            Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.ViewMembersCommand}"
                                            CommandParameter="{Binding Fridge}" />
                                    <Button Text="Manage"
                                            Style="{StaticResource OutlineButtonStyle}"
                                            IsVisible="{Binding IsOwner}"
                                            Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.OpenManageCommand}"
                                            CommandParameter="{Binding Fridge}" />
                                    <Button Text="Delete"
                                            Style="{StaticResource DangerButtonStyle}"
                                            IsVisible="{Binding IsOwner}"
                                            Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.DeleteFridgeCommand}"
                                            CommandParameter="{Binding Fridge}" />
                                </HorizontalStackLayout>

                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>

        <Grid IsVisible="{Binding IsViewMembersVisible}">
            <BoxView Color="Black" Opacity="0.7" />
            <Border HorizontalOptions="Center"
                    VerticalOptions="Center"
                    WidthRequest="320"
                    Padding="24"
                    Style="{StaticResource CardStyle}">
                <VerticalStackLayout Spacing="16">

                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="{Binding SelectedFridgeName, StringFormat='Members — {0}'}"
                               Style="{StaticResource ModalTitleStyle}" />
                        <Button Grid.Column="1"
                                Text="✕"
                                Style="{StaticResource OutlineButtonStyle}"
                                Command="{Binding CloseViewMembersCommand}"
                                WidthRequest="40"
                                HeightRequest="40"
                                Padding="0"
                                FontSize="14" />
                    </Grid>

                    <BoxView HeightRequest="1"
                             BackgroundColor="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" />

                    <CollectionView ItemsSource="{Binding FridgeMembers}"
                                    MaximumHeightRequest="300">
                        <CollectionView.EmptyView>
                            <Label Text="No members yet."
                                   Style="{StaticResource MutedLabelStyle}"
                                   HorizontalOptions="Center" />
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Label Text="{Binding DisplayName}"
                                       FontSize="15"
                                       Padding="0,6" />
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                </VerticalStackLayout>
            </Border>
        </Grid>

        <Grid IsVisible="{Binding IsManageVisible}">
            <BoxView Color="Black" Opacity="0.7" />
            <Border HorizontalOptions="Center"
                    VerticalOptions="Center"
                    WidthRequest="320"
                    Padding="24"
                    Style="{StaticResource CardStyle}">
                <VerticalStackLayout Spacing="14">

                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="{Binding SelectedFridgeName, StringFormat='Manage — {0}'}"
                               Style="{StaticResource ModalTitleStyle}" />
                        <Button Grid.Column="1"
                                Text="✕"
                                Style="{StaticResource OutlineButtonStyle}"
                                Command="{Binding CloseManageCommand}"
                                WidthRequest="40"
                                HeightRequest="40"
                                Padding="0"
                                FontSize="14" />
                    </Grid>

                    <BoxView HeightRequest="1"
                             BackgroundColor="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" />

                    <Label Text="Members"
                           Style="{StaticResource SectionTitleStyle}" />

                    <CollectionView ItemsSource="{Binding FridgeMembers}"
                                    MaximumHeightRequest="180">
                        <CollectionView.EmptyView>
                            <Label Text="No members yet."
                                   Style="{StaticResource MutedLabelStyle}"
                                   HorizontalOptions="Center" />
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="*,Auto" Padding="0,4">
                                    <Label Text="{Binding DisplayName}"
                                           VerticalOptions="Center" />
                                    <Button Grid.Column="1"
                                            Text="Remove"
                                            Style="{StaticResource DangerButtonStyle}"
                                            FontSize="12"
                                            Padding="10,6"
                                            Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.RemoveMemberCommand}"
                                            CommandParameter="{Binding .}" />
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <BoxView HeightRequest="1"
                             BackgroundColor="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" />

                    <Label Text="Add member by email"
                           Style="{StaticResource SectionTitleStyle}" />

                    <Border Style="{StaticResource InputBorderStyle}">
                        <Entry Placeholder="Email address"
                               Text="{Binding AddMemberEmail}"
                               Keyboard="Email" />
                    </Border>

                    <Label Text="{Binding ManageError}"
                           Style="{StaticResource ErrorLabelStyle}"
                           IsVisible="{Binding HasManageError}" />

                    <Button Text="Add Member"
                            Command="{Binding AddMemberCommand}" />

                </VerticalStackLayout>
            </Border>
        </Grid>

        <Grid IsVisible="{Binding IsCreateFridgeVisible}">
            <BoxView Color="Black" Opacity="0.7" />
            <Border HorizontalOptions="Center"
                    VerticalOptions="Center"
                    WidthRequest="320"
                    Padding="24"
                    Style="{StaticResource CardStyle}">
                <VerticalStackLayout Spacing="16">

                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="New Fridge"
                               Style="{StaticResource ModalTitleStyle}" />
                        <Button Grid.Column="1"
                                Text="✕"
                                Style="{StaticResource OutlineButtonStyle}"
                                Command="{Binding CloseCreateFridgeCommand}"
                                WidthRequest="40"
                                HeightRequest="40"
                                Padding="0"
                                FontSize="14" />
                    </Grid>

                    <BoxView HeightRequest="1"
                             BackgroundColor="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" />

                    <Border Style="{StaticResource InputBorderStyle}">
                        <Entry Placeholder="Fridge name"
                               Text="{Binding NewFridgeName}" />
                    </Border>

                    <Button Text="Create"
                            Command="{Binding ConfirmCreateFridgeCommand}" />

                </VerticalStackLayout>
            </Border>
        </Grid>

    </Grid>

</ContentPage>
