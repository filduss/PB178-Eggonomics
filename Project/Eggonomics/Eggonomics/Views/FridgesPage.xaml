<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Eggonomics.Views.FridgesPage"
             xmlns:vm="clr-namespace:Eggonomics.ViewModels"
             x:Name="ThisPage">

    <Grid>

        <VerticalStackLayout Padding="16,12" Spacing="12">

            <Grid ColumnDefinitions="*,Auto">
                <Label Text="Fridges"
                       FontSize="24"
                       FontAttributes="Bold"
                       VerticalOptions="Center" />
                <Button Grid.Column="1"
                        Text="Sign Out"
                        Command="{Binding SignOutCommand}" />
            </Grid>

            <Button Text="+ Create Fridge"
                    HorizontalOptions="Start"
                    Command="{Binding OpenCreateFridgeCommand}" />

            <CollectionView ItemsSource="{Binding Fridges}">
                <CollectionView.EmptyView>
                    <Label Text="No fridges yet."
                           TextColor="Gray"
                           HorizontalOptions="Center"
                           Margin="0,24" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="16,12"
                                Margin="0,4"
                                StrokeShape="RoundRectangle 8">
                            <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto">
                                <Label Text="{Binding Fridge.Name}"
                                       FontSize="16"
                                       VerticalOptions="Center" />
                                <Button Grid.Column="1"
                                        Text="Enter"
                                        Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.EnterFridgeCommand}"
                                        CommandParameter="{Binding Fridge}" />
                                <Button Grid.Column="2"
                                        Text="Members"
                                        Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.ViewMembersCommand}"
                                        CommandParameter="{Binding Fridge}" />
                                <Button Grid.Column="3"
                                        Text="Manage"
                                        IsVisible="{Binding IsOwner}"
                                        Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.OpenManageCommand}"
                                        CommandParameter="{Binding Fridge}" />
                                <Button Grid.Column="4"
                                        Text="Delete"
                                        TextColor="White"
                                        BackgroundColor="Red"
                                        IsVisible="{Binding IsOwner}"
                                        Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.DeleteFridgeCommand}"
                                        CommandParameter="{Binding Fridge}" />
                                <Button Grid.Column="4"
                                        Text="Leave"
                                        Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.LeaveFridgeCommand}"
                                        CommandParameter="{Binding Fridge}">
                                    <Button.Triggers>
                                        <DataTrigger TargetType="Button" Binding="{Binding IsOwner}" Value="True">
                                            <Setter Property="IsVisible" Value="False" />
                                        </DataTrigger>
                                    </Button.Triggers>
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>

        <Grid IsVisible="{Binding IsViewMembersVisible}">
            <BoxView Color="Black" Opacity="0.9" />
            <Border HorizontalOptions="Center"
                    VerticalOptions="Center"
                    WidthRequest="320"
                    Padding="24"
                    StrokeShape="RoundRectangle 12">
                <VerticalStackLayout Spacing="16">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="{Binding SelectedFridgeName, StringFormat='Members of {0}'}"
                               FontSize="18"
                               FontAttributes="Bold"
                               VerticalOptions="Center" />
                        <Button Grid.Column="1"
                                Text="✕"
                                Command="{Binding CloseViewMembersCommand}"
                                WidthRequest="36"
                                HeightRequest="36"
                                Padding="0"
                                FontSize="14" />
                    </Grid>
                    <CollectionView ItemsSource="{Binding FridgeMembers}">
                        <CollectionView.EmptyView>
                            <Label Text="No members yet."
                                   TextColor="Gray"
                                   HorizontalOptions="Center" />
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Label Text="{Binding DisplayName}"
                                       FontSize="15"
                                       Padding="0,6" />
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>
        </Grid>

        <Grid IsVisible="{Binding IsManageVisible}">
            <BoxView Color="Black" Opacity="0.9" />
            <Border HorizontalOptions="Center"
                    VerticalOptions="Center"
                    WidthRequest="320"
                    Padding="24"
                    StrokeShape="RoundRectangle 12">
                <VerticalStackLayout Spacing="16">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="{Binding SelectedFridgeName, StringFormat='Manage {0}'}"
                               FontSize="18"
                               FontAttributes="Bold"
                               VerticalOptions="Center" />
                        <Button Grid.Column="1"
                                Text="✕"
                                Command="{Binding CloseManageCommand}"
                                WidthRequest="36"
                                HeightRequest="36"
                                Padding="0"
                                FontSize="14" />
                    </Grid>
                    <Label Text="Add member by email" FontSize="14" />
                    <Entry Placeholder="Email"
                           Text="{Binding AddMemberEmail}"
                           Keyboard="Email" />
                    <Label Text="{Binding ManageError}"
                           TextColor="Red"
                           IsVisible="{Binding HasManageError}"
                           FontSize="13" />
                    <Button Text="Add Member"
                            Command="{Binding AddMemberCommand}" />
                </VerticalStackLayout>
            </Border>
        </Grid>

        <Grid IsVisible="{Binding IsCreateFridgeVisible}">
            <BoxView Color="Black" Opacity="0.9" />
            <Border HorizontalOptions="Center"
                    VerticalOptions="Center"
                    WidthRequest="320"
                    Padding="24"
                    StrokeShape="RoundRectangle 12">
                <VerticalStackLayout Spacing="16">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Create Fridge"
                               FontSize="18"
                               FontAttributes="Bold"
                               VerticalOptions="Center" />
                        <Button Grid.Column="1"
                                Text="✕"
                                Command="{Binding CloseCreateFridgeCommand}"
                                WidthRequest="36"
                                HeightRequest="36"
                                Padding="0"
                                FontSize="14" />
                    </Grid>
                    <Entry Placeholder="Fridge name"
                           Text="{Binding NewFridgeName}" />
                    <Button Text="Create"
                            Command="{Binding ConfirmCreateFridgeCommand}" />
                </VerticalStackLayout>
            </Border>
        </Grid>

    </Grid>

</ContentPage>
