<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Eggonomics.Views.FridgesPage"
             xmlns:vm="clr-namespace:Eggonomics.ViewModels">

    <Grid>

        <!-- Main content -->
        <VerticalStackLayout Padding="16,12" Spacing="12">

            <Grid ColumnDefinitions="*,Auto">
                <Label Text="Fridges"
                       FontSize="24"
                       FontAttributes="Bold"
                       VerticalOptions="Center" />
                <Button Grid.Column="1"
                        Text="Sign Out"
                        Command="{Binding SignOutCommand}" />
            </Grid>

            <Button Text="+ Create Fridge"
                    HorizontalOptions="Start"
                    Command="{Binding OpenCreateFridgeCommand}" />

            <CollectionView ItemsSource="{Binding Fridges}">
                <CollectionView.EmptyView>
                    <Label Text="No fridges yet."
                           TextColor="Gray"
                           HorizontalOptions="Center"
                           Margin="0,24" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="16,12"
                                Margin="0,4"
                                StrokeShape="RoundRectangle 8">
                            <Label Text="{Binding Name}"
                                   FontSize="16" />
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>

        <!-- Create Fridge overlay -->
        <Grid IsVisible="{Binding IsCreateFridgeVisible}">

            <BoxView Color="Black" Opacity="0.9" />

            <Border HorizontalOptions="Center"
                    VerticalOptions="Center"
                    WidthRequest="320"
                    Padding="24"
                    StrokeShape="RoundRectangle 12">
                <VerticalStackLayout Spacing="16">

                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Create Fridge"
                               FontSize="18"
                               FontAttributes="Bold"
                               VerticalOptions="Center" />
                        <Button Grid.Column="1"
                                Text="✕"
                                Command="{Binding CloseCreateFridgeCommand}"
                                WidthRequest="36"
                                HeightRequest="36"
                                Padding="0"
                                FontSize="14" />
                    </Grid>

                    <Entry Placeholder="Fridge name"
                           Text="{Binding NewFridgeName}" />

                    <Button Text="Create"
                            Command="{Binding ConfirmCreateFridgeCommand}" />

                </VerticalStackLayout>
            </Border>

        </Grid>

    </Grid>

</ContentPage>
